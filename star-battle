/* ===== لودینگ پیشرفته ===== */
#loader {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 40%, #ffffff 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  overflow: hidden;
}

.loader-content {
  text-align: center;
  position: relative;
  z-index: 2;
}

/* حلقه چرخان دور لوگو */
.loader-ring {
  position: absolute;
  top: -30px; left: 50%;
  transform: translateX(-50%);
  width: 120px; height: 120px;
  border: 4px solid transparent;
  border-top-color: #3b82f6;
  border-right-color: #06b6d4;
  border-radius: 50%;
  animation: spinRing 1.5s linear infinite;
}
@keyframes spinRing {
  to { transform: translateX(-50%) rotate(360deg); }
}

.loader-logo {
  font-size: 80px;
  animation: bounceLogo 1.2s ease-in-out infinite;
  margin-bottom: 20px;
  position: relative;
  z-index: 2;
}
@keyframes bounceLogo {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-18px) scale(1.1); }
}

.loader-title {
  font-size: 34px;
  font-weight: bold;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 10px;
  letter-spacing: 2px;
  animation: fadeIn 1s ease;
}

.loader-text {
  font-size: 18px;
  color: #475569;
  margin-bottom: 25px;
  letter-spacing: 3px;
  animation: fadeIn 1.5s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* نقطه‌های انیمیشنی */
.loader-dots { display: flex; justify-content: center; gap: 10px; }
.loader-dots span {
  width: 12px; height: 12px;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  border-radius: 50%;
  animation: dotBounce 1.4s ease-in-out infinite;
}
.loader-dots span:nth-child(2) { animation-delay: 0.2s; }
.loader-dots span:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1.2); opacity: 1; }
}

/* ذرات شناور پس‌زمینه لودر */
.loader-particles {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 1;
}
.loader-particles span {
  position: absolute;
  width: 8px; height: 8px;
  background: rgba(59, 130, 246, 0.4);
  border-radius: 50%;
  animation: particleFloat 8s linear infinite;
}
.loader-particles span:nth-child(1) { left: 10%; animation-delay: 0s; }
.loader-particles span:nth-child(2) { left: 20%; animation-delay: 1s; }
.loader-particles span:nth-child(3) { left: 30%; animation-delay: 2s; }
.loader-particles span:nth-child(4) { left: 40%; animation-delay: 3s; }
.loader-particles span:nth-child(5) { left: 50%; animation-delay: 4s; }
.loader-particles span:nth-child(6) { left: 60%; animation-delay: 5s; }
.loader-particles span:nth-child(7) { left: 70%; animation-delay: 6s; }
.loader-particles span:nth-child(8) { left: 80%; animation-delay: 7s; }
.loader-particles span:nth-child(9) { left: 90%; animation-delay: 0.5s; }
.loader-particles span:nth-child(10) { left: 15%; animation-delay: 2.5s; }

@keyframes particleFloat {
  0% { transform: translateY(100vh) scale(0); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateY(-100px) scale(1); opacity: 0; }
}

/* ===== کارت‌های شناور ===== */
.card.float1 { animation: floatCard1 4s ease-in-out infinite; }
.card.float2 { animation: floatCard2 4s ease-in-out infinite; animation-delay: 0.5s; }
.card.float3 { animation: floatCard3 4s ease-in-out infinite; animation-delay: 1s; }

@keyframes floatCard1 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}
@keyframes floatCard2 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-18px); }
}
@keyframes floatCard3 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.hidden { opacity: 0; }

* { margin: 0; padding: 0; box-sizing: border-box; font-family: Tahoma, sans-serif; }
html { scroll-behavior: smooth; }

body {
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 40%, #ffffff 100%);
  color: #0f172a;
  line-height: 1.7;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ===== لودر ===== */
#loader {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 40%, #ffffff 100%);
  display: flex; justify-content: center; align-items: center;
  z-index: 9999;
}
.loader-content { text-align: center; }
.loader-logo { font-size: 80px; animation: bounce 1s infinite; margin-bottom: 15px; }
@keyframes bounce { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-20px);} }
.loader-title { font-size: 34px; color: #1d4ed8; margin-bottom: 15px; }
.loader-text { color: #475569; margin-bottom: 20px; letter-spacing: 3px; }
.loader-spinner {
  width: 50px; height: 50px;
  border: 4px solid rgba(59,130,246,0.2);
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}
@keyframes spin { to { transform: rotate(360deg); } }
.hidden { opacity: 0; }

/* ===== پس‌زمینه ===== */
.bg-blobs { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
.blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.5; animation: float 14s ease-in-out infinite; }
.blob1 { width: 400px; height: 400px; background: #60a5fa; top: -100px; right: -100px; }
.blob2 { width: 350px; height: 350px; background: #38bdf8; bottom: -100px; left: -100px; animation-delay: 4s; }
.blob3 { width: 300px; height: 300px; background: #93c5fd; top: 40%; left: 40%; animation-delay: 8s; }
@keyframes float { 0%,100%{transform:translate(0,0) scale(1);} 50%{transform:translate(30px,-30px) scale(1.1);} }

.container { max-width: 1100px; margin: auto; padding: 0 20px; }
.glass {
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.9);
  box-shadow: 0 8px 32px rgba(59,130,246,0.15), inset 0 1px 0 rgba(255,255,255,0.8);
}

/* ===== هدر ===== */
header { padding: 20px 0; position: sticky; top: 10px; z-index: 100; }
.header-box { display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; border-radius: 22px; flex-wrap: wrap; gap: 10px; }
.logo { font-size: 22px; font-weight: bold; color: #1d4ed8; }
nav a { color: #1e293b; text-decoration: none; margin-left: 15px; transition: 0.3s; font-weight: 600; font-size: 14px; }
nav a:hover { color: #1d4ed8; }
.btn-bot { background: linear-gradient(135deg, #3b82f6, #06b6d4); color: #fff !important; padding: 8px 16px; border-radius: 12px; font-weight: bold; }

/* ===== بنر ===== */
.hero { padding: 60px 0; }
.hero-box { text-align: center; padding: 60px 30px; border-radius: 30px; }
.hero h1 { font-size: 38px; margin-bottom: 15px; color: #1e293b; }
.hero h1 span { background: linear-gradient(135deg, #3b82f6, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.hero p { font-size: 17px; margin-bottom: 25px; color: #475569; }
.search-box { display: flex; gap: 10px; max-width: 500px; margin: 0 auto 25px; }
.search-box input {
  flex: 1;
  padding: 14px 20px;
  border-radius: 15px;
  border: 1px solid rgba(59,130,246,0.3);
  background: rgba(255,255,255,0.8);
  font-size: 15px;
  outline: none;
  color: #0f172a;
}
.search-box input:focus { border-color: #3b82f6; }
.search-box button {
  padding: 14px 25px;
  border: none;
  border-radius: 15px;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}
.search-box button:hover { transform: scale(1.05); }

.btn-main {
  display: inline-block;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
  padding: 14px 35px;
  border-radius: 15px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
  box-shadow: 0 8px 25px rgba(59,130,246,0.4);
}
.btn-main:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(59,130,246,0.6); }

/* ===== محصولات ===== */
.products { padding: 60px 20px; }
.products h2 { text-align: center; font-size: 30px; margin-bottom: 40px; color: #1e293b; }
.products h2::after { content: ''; display: block; width: 70px; height: 4px; background: linear-gradient(90deg, #3b82f6, #06b6d4); margin: 12px auto 0; border-radius: 2px; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px; }

.card {
  padding: 30px 20px;
  text-align: center;
  border-radius: 25px;
  transition: 0.4s;
  position: relative;
}
.card.float1 { animation: floatCard1 4s ease-in-out infinite; }
.card.float2 { animation: floatCard2 4s ease-in-out infinite; animation-delay: 0.5s; }
.card.float3 { animation: floatCard3 4s ease-in-out infinite; animation-delay: 1s; }
@keyframes floatCard1 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-12px);} }
@keyframes floatCard2 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-18px);} }
@keyframes floatCard3 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
.card:hover { transform: translateY(-15px); border-color: rgba(59,130,246,0.5); }

.wish-btn {
  position: absolute;
  top: 15px;
  left: 15px;
  background: rgba(255,255,255,0.8);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.3s;
}
.wish-btn:hover { transform: scale(1.15); }

.badge {
  position: absolute;
  top: 15px;
  right: 15px;
  padding: 5px 12px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: bold;
  color: #fff;
}
.badge.new { background: linear-gradient(135deg, #10b981, #059669); }
.badge.hot { background: linear-gradient(135deg, #ef4444, #dc2626); }

.card-img { font-size: 70px; margin-bottom: 15px; }
.card h3 { font-size: 19px; margin-bottom: 8px; color: #1e293b; }
.card p { font-size: 13px; color: #64748b; margin-bottom: 10px; }
.rating { font-size: 13px; color: #f59e0b; margin-bottom: 12px; }
.price { font-size: 20px; font-weight: bold; color: #1d4ed8; margin-bottom: 20px; }
.btn-buy {
  display: inline-block;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
  padding: 11px 35px;
  border-radius: 12px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
  box-shadow: 0 4px 20px rgba(59,130,246,0.4);
}
.btn-buy:hover { transform: scale(1.05); }

/* ===== فیلتر ===== */
.filters { display: flex; justify-content: center; gap: 10px; margin-bottom: 30px; flex-wrap: wrap; }
.filter-btn {
  padding: 10px 22px;
  border-radius: 12px;
  border: 1px solid rgba(59,130,246,0.3);
  background: rgba(255,255,255,0.6);
  color: #1e293b;
  cursor: pointer;
  font-weight: bold;
  transition: 0.3s;
}
.filter-btn.active, .filter-btn:hover {
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
}

/* ===== مقایسه ===== */
.compare-box { padding: 40px 30px; border-radius: 25px; text-align: center; }
.compare-box select {
  padding: 12px 20px;
  border-radius: 12px;
  border: 1px solid rgba(59,130,246,0.3);
  background: rgba(255,255,255,0.8);
  margin: 8px;
  font-size: 14px;
  color: #0f172a;
}
#compareResult { margin-top: 25px; }
.compare-table {
  width: 100%;
  margin-top: 20px;
  border-collapse: collapse;
  border-radius: 15px;
  overflow: hidden;
}
.compare-table th, .compare-table td {
  padding: 12px;
  text-align: center;
  border-bottom: 1px solid rgba(59,130,246,0.2);
}
.compare-table th { background: rgba(59,130,246,0.15); color: #1d4ed8; }

/* ===== سفارشات ===== */
.orders-box { padding: 50px 30px; border-radius: 25px; text-align: center; }
.orders-box p { color: #475569; margin-bottom: 15px; }

/* ===== تماس ===== */
.contact { padding: 60px 20px 100px; }
.contact-box { padding: 50px 30px; border-radius: 25px; text-align: center; }
.contact h2 { font-size: 30px; margin-bottom: 30px; color: #1e293b; }
.contact-buttons { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
.contact-btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 15px;
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
  box-shadow: 0 4px 20px rgba(59,130,246,0.4);
}
.contact-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(59,130,246,0.6); }

footer { text-align: center; padding: 25px; font-size: 14px; color: #64748b; }

@media (max-width: 600px) {
  .header-box { flex-direction: column; }
  nav a { margin: 0 5px; font-size: 12px; }
  .hero h1 { font-size: 26px; }
  .hero p { font-size: 14px; }
  .products h2 { font-size: 24px; }
  .search-box { flex-direction: column; }
}
